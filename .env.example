# 42VoiceBridge_BE 배포 환경변수 템플릿
# 값 설명과 출처는 docs/DEPLOYMENT.md 참고.
# 이 파일에는 실제 값을 채우지 마세요 — 그대로 커밋되는 예시 파일입니다.

SPRING_PROFILES_ACTIVE=prod

# --- Database (42VoiceBridge_Infra 2_storage 레이어) ---
DB_URL=<2_storage의 rds_endpoint로 조합: jdbc:mysql://호스트:포트/voicebridge?serverTimezone=Asia/Seoul&characterEncoding=UTF-8>
DB_USERNAME=<2_storage terraform.tfvars에 넣은 db_username>
DB_PASSWORD=<Secrets Manager에서 조회 — docs/DEPLOYMENT.md 참고>

# --- Redis (42VoiceBridge_Infra 2_storage 레이어) ---
REDIS_HOST=<2_storage의 redis_endpoint>
REDIS_PORT=<2_storage의 redis_port>

# --- JWT ---
JWT_SECRET=<배포자가 직접 생성: openssl rand -base64 32>

# --- AI 서버 (42VoiceBridge_Infra 범위 밖) ---
AI_SERVER_BASE_URL=<AI팀에게 문의한 실제 서버 주소>

# --- S3 (42VoiceBridge_Infra 2_storage 레이어) ---
S3_BUCKET=<2_storage의 s3_bucket_name>
AWS_REGION=ap-northeast-2

# --- 네이버 클라우드 CLOVA Voice (NCP 콘솔에서 수동 발급, 인프라 범위 밖) ---
NCP_TTS_API_KEY_ID=<NCP 콘솔에서 발급>
NCP_TTS_API_KEY=<NCP 콘솔에서 발급>
